# Optional overrides, for development only: release builds ignore .env.
# Copy to .env in this source folder (the one with Cargo.toml): development
# builds read it from here, never from the folder they're started in. Only
# TT_* keys are read.

# Where your subscriptions, history and settings are kept: a full path.
# Default: the platform's app data directory (see `tuitube --help`).
# TT_DATA_DIR=/Users/you/tt-test

# Where yt-dlp, mpv and Deno are, if they aren't on PATH.
# TT_YT_DLP=/opt/homebrew/bin/yt-dlp
# TT_MPV=/opt/homebrew/bin/mpv
# TT_DENO=/opt/homebrew/bin/deno
